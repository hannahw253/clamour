# Copy to .env.local for local development. In Vercel, set these under Settings → Environment Variables.
# Both come from the Supabase project "clamour" (London): Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI help with messages (north star, decision D-024). Leave empty to keep AI switched off.
# An AWS IAM user allowed only bedrock:InvokeModel, in the London region.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
AI_DAILY_CAP=300
